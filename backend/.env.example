# ============================================
# Brazas$Mar - Variables de entorno (ejemplo)
# Copia este archivo a `.env` y completa los valores
# ============================================

# Servidor
PORT=4000
NODE_ENV=development

# MongoDB
# Local:    mongodb://127.0.0.1:27017/brazasmar
# Atlas:    mongodb+srv://USER:PASS@cluster.mongodb.net/brazasmar
MONGODB_URI=mongodb://127.0.0.1:27017/brazasmar
DATABASE_URL=mongodb://127.0.0.1:27017/brazasmar

# Auth
# IMPORTANTE: cambia este valor en producción. Usa una cadena aleatoria larga.
AUTH_SECRET=brazasmar-dev-secret-change-in-production

# Admin inicial (solo se usa la primera vez, al crear el admin)
ADMIN_EMAIL=admin@brazasmar.local
ADMIN_PASSWORD=admin123

# CORS - lista de orígenes permitidos separados por coma, o * para todos
CORS_ORIGIN=*
